    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "description": "Exact API_PUBLIC_URL origin; required for browser mutations.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Shipkeep-CSRF",
            "in": "header",
            "description": "CSRF cookie value bound to this session.",
            "required": true,
            "schema": {
              "type": "string"
