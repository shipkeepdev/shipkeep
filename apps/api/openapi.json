  "info": {
    "title": "Shipkeep API",
    "description": "Public REST API of the Shipkeep control plane. Errors are RFC 9457 problem details.",
    "version": "dev",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "apiToken": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "API token (Authorization: Bearer <token>)"
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-shipkeep_session",
        "description": "HTTPS session cookie; HTTP development uses shipkeep_session."
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "version": {
            "type": "string",
            "example": "0.1.0"
          }
        },
        "required": [
          "status",
          "version"
        ]
      },
      "ReadinessChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "database"
        ]
      },
      "ReadinessDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecksDto"
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "CredentialsDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "person@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 15,
            "maxLength": 128,
            "writeOnly": true,
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "EmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "person@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "EmailCodeDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43,
            "writeOnly": true
          }
        },
        "required": [
          "token"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43,
            "writeOnly": true
          },
          "password": {
            "type": "string",
            "minLength": 15,
            "maxLength": 128,
            "writeOnly": true,
            "format": "password"
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "LoginCredentialsDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "person@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 15,
            "maxLength": 128,
            "writeOnly": true,
            "format": "password"
          },
          "totp": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "writeOnly": true
          },
          "recovery": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "userId",
          "email",
          "expiresAt"
        ]
      },
      "MfaStatusDto": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "pendingExpiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "recoveryCodesRemaining": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        },
        "required": [
          "enabled",
          "pendingExpiresAt",
          "recoveryCodesRemaining"
        ]
      },
      "MfaPasswordDto": {
        "type": "object",
        "properties": {
          "password": {
            "type": "string",
            "minLength": 15,
            "maxLength": 128,
            "writeOnly": true,
            "format": "password"
          }
        },
        "required": [
          "password"
        ]
      },
      "MfaSetupDto": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string",
            "description": "Private base32 seed. Store only in the authenticator."
          },
          "provisioningUri": {
            "type": "string",
            "description": "Private otpauth provisioning data; never a navigation URL."
          },
