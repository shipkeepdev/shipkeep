{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/jest",
    "types": ["vitest/globals", "node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": [
    "vitest.config.mts",
    "vitest.integration.config.mts",
    "prisma.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "src/test-setup.ts",
    "src/testing/**/*.ts",
    "src/test-setup.integration.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
