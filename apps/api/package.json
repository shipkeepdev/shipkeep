{
  "name": "@shipkeep/api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "api",
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/api/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/api/dist/patches",
          "{workspaceRoot}/apps/api/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "api:build:development"
          },
          "production": {
            "buildTarget": "api:build:production"
          }
        }
      },
      "test:integration": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "vitest run --config vitest.integration.config.mts",
          "cwd": "apps/api"
        },
        "dependsOn": [
          "^build"
        ]
      },
      "dev-mail": {
        "continuous": true,
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node tools/dev/mail.mjs"
        }
      },
      "test:browser": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "vitest run --config vitest.browser.config.mts",
          "cwd": "apps/api"
        },
        "dependsOn": [
          "^build",
          {
            "target": "build",
            "projects": [
              "web"
            ]
          }
        ]
      }
    },
    "tags": [
      "type:app",
      "scope:api"
    ]
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-node": "^2.3.0",
    "@nestjs/common": "^12.3.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.1",
    "@nestjs/platform-express": "^12.3.1",
    "@nestjs/swagger": "^12.0.5",
    "@peculiar/x509": "^2.2.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@shipkeep/config-schema": "workspace:*",
    "@shipkeep/domain": "workspace:*",
    "@shipkeep/proto-ts": "workspace:*",
    "argon2": "0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "emailjs": "5.0.4",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.3.1",
    "otpauth": "9.4.1",
    "pg-boss": "12.38.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@nestjs/testing": "^12.3.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "playwright": "1.64.1",
    "supertest": "^7.3.1"
  }
}
