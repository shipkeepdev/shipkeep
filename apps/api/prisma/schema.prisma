// Control plane data model (SPEC section 4). Table and column names are snake_case; ids are
// UUIDv7 generated by the application.

generator client {
  provider = "prisma-client"
  output   = "../src/platform/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

/// Installation-wide identity. Email ownership is required before organization membership.
model User {
  id              String              @id @db.Uuid
  email           String              @unique @db.Citext
  passwordHash    String              @map("password_hash") @db.VarChar(256)
  status          String              @default("pending") @db.VarChar(16)
  emailVerifiedAt DateTime?           @map("email_verified_at") @db.Timestamptz(6)
  securityVersion Int                 @default(0) @map("security_version")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions        UserSession[]
  identityTokens  IdentityToken[]
  mfa             UserMfa?
  apiTokens       ApiToken[]
  memberships     Membership[]
  confirmations   ConfirmationToken[]

  @@map("users")
}

model Organization {
  id            String              @id @db.Uuid
  name          String              @db.VarChar(80)
  slug          String              @unique @db.VarChar(40)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships   Membership[]
  projects      Project[]
  environments  Environment[]
  roleBindings  RoleBinding[]
  nodes         Node[]
  joinTokens    JoinToken[]
  confirmations ConfirmationToken[]

  @@map("organizations")
}

model Membership {
  id             String        @id @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  orgRole        String        @default("member") @map("org_role") @db.VarChar(16)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  roleBindings   RoleBinding[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId])
  @@map("memberships")
}

model Project {
  id             String        @id @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String        @db.VarChar(80)
  slug           String        @db.VarChar(40)
  gitWriteMode   String        @default("pull_request") @map("git_write_mode") @db.VarChar(16)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  environments   Environment[]
  apiTokens      ApiToken[]
  roleBindings   RoleBinding[]

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
  @@map("projects")
}

model Environment {
  id             String        @id @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  projectId      String        @map("project_id") @db.Uuid
  name           String        @db.VarChar(40)
  kind           String        @default("standard") @db.VarChar(16)
  failoverPolicy String        @default("none") @map("failover_policy") @db.VarChar(32)
  protected      Boolean       @default(true)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project       @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  roleBindings   RoleBinding[]

  secrets      Secret[]
  applications Application[]

  @@unique([projectId, name])
  @@unique([organizationId, projectId, id])
  @@map("environments")
}

model RoleBinding {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  membershipId   String       @map("membership_id") @db.Uuid
  projectId      String       @map("project_id") @db.Uuid
  environmentId  String?      @map("environment_id") @db.Uuid
  role           String       @db.VarChar(16)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     Membership   @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  project        Project      @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  environment    Environment? @relation(fields: [organizationId, projectId, environmentId], references: [organizationId, projectId, id], onDelete: Cascade)

  /// The migration uses NULLS NOT DISTINCT so project-wide bindings are unique too.
  @@unique([membershipId, projectId, environmentId])
  @@index([organizationId, projectId, environmentId])
  @@map("role_bindings")
}

/// User-owned API credentials; only the purpose-bound hash is persisted.
model ApiToken {
  id              String    @id @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  name            String    @db.VarChar(64)
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  scopes          Json
  securityVersion Int       @map("security_version")
  createdAt       DateTime  @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(6)
  /// Set together for a project-bound token (PLAN M2.3e); null for an account-wide token.
  organizationId  String?   @map("organization_id") @db.Uuid
  projectId       String?   @map("project_id") @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project?  @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId, id])
  @@index([organizationId, projectId, id])
  @@index([userId, securityVersion, expiresAt])
  @@map("api_tokens")
}

/// Encrypted active or pending TOTP seed; pending enrollment is tied to the security version.
model UserMfa {
  userId            String         @id @map("user_id") @db.Uuid
  activeCiphertext  Bytes?         @map("active_ciphertext")
  enabledAt         DateTime?      @map("enabled_at") @db.Timestamptz(6)
  lastCounter       BigInt?        @map("last_counter")
  pendingCiphertext Bytes?         @map("pending_ciphertext")
  pendingVersion    Int?           @map("pending_version")
  pendingCreatedAt  DateTime?      @map("pending_created_at") @db.Timestamptz(6)
  pendingExpiresAt  DateTime?      @map("pending_expires_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes     RecoveryCode[]

  @@map("user_mfa")
}

model RecoveryCode {
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  createdAt DateTime  @map("created_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  mfa       UserMfa   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, codeHash])
  @@map("recovery_codes")
}

/// Opaque browser credential and CSRF verifier. Privilege changes invalidate older versions.
model UserSession {
  id              String    @id @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  csrfHash        String    @map("csrf_hash") @db.Char(64)
  securityVersion Int       @map("security_version")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastSeenAt      DateTime  @map("last_seen_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  ip              String    @db.VarChar(45)
  userAgent       String    @map("user_agent") @db.VarChar(512)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// Single-use email verification/reset credentials. Plaintext is only delivered to the mailbox.
model IdentityToken {
  id              String    @id @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  purpose         String    @db.VarChar(16)
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  securityVersion Int       @map("security_version")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("identity_tokens")
}

/// Authentication telemetry shared across API instances; keys are purpose-separated hashes.
model IdentityThrottle {
  id            String   @id @db.Uuid
  keyHash       String   @unique @map("key_hash") @db.Char(64)
  hits          Int
  windowEndsAt  DateTime @map("window_ends_at") @db.Timestamptz(6)
  nextAllowedAt DateTime @map("next_allowed_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([windowEndsAt])
  @@map("identity_throttles")
}

/// Append-only audit log built from domain events. No update or delete path exists in the code;
/// task M2.4 adds the database permissions that make it impossible for the API role as well.
model AuditEvent {
  id             String   @id @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorKind      String   @map("actor_kind") @db.VarChar(16)
  actorId        String?  @map("actor_id") @db.VarChar(128)
  ip             String?  @db.VarChar(45)
  action         String   @db.VarChar(128)
  targetType     String   @map("target_type") @db.VarChar(64)
  targetId       String   @map("target_id") @db.VarChar(128)
  metadata       Json
  createdAt      DateTime @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_events")
}

/// Short-lived encrypted request/response pairs for retrying authentication mutations.
model IdentityReplay {
  keyHash    String   @id @map("key_hash") @db.Char(64)
  ciphertext Bytes
  createdAt  DateTime @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("identity_replays")
}

/// Data-encryption keys of envelope encryption (SPEC section 9), one per scope (for example
/// `environment:<id>`), each wrapped by the key-encryption key of the given version.
model DataEncryptionKey {
  id         String   @id @db.Uuid
  scope      String   @unique @db.VarChar(128)
  wrappedKey Bytes    @map("wrapped_key")
  kekVersion Int      @map("kek_version")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("data_encryption_keys")
}

/// Long-lived installation key pairs: the internal CA (SPEC 3.2) and the confirmation token signing
/// key (SPEC 3.6). Private keys are encrypted with the KEK through EnvelopeService.
model InstallationKey {
  id             String    @id @db.Uuid
  kind           String    @unique @db.VarChar(32)
  certificatePem String?   @map("certificate_pem")
  publicKeyPem   String    @map("public_key_pem")
  privateKeyEnc  Bytes     @map("private_key_enc")
  notAfter       DateTime? @map("not_after") @db.Timestamptz(6)
  createdAt      DateTime  @map("created_at") @db.Timestamptz(6)

  @@map("installation_keys")
}

/// Single-use enrollment tokens (SPEC 3.2). Only the SHA-256 of the value is stored.
model JoinToken {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  tokenHash      String       @unique @map("token_hash") @db.Char(64)
  createdBy      String?      @map("created_by") @db.VarChar(128)
  createdAt      DateTime     @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime?    @map("used_at") @db.Timestamptz(6)
  usedByNodeId   String?      @map("used_by_node_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, expiresAt])
  @@map("join_tokens")
}

/// A server running shipkeep-agent (SPEC 4, 5.2).
model Node {
  id              String            @id @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  name            String            @db.VarChar(40)
  status          String            @db.VarChar(16)
  labels          Json
  facts           Json
  leaseEpoch      Int               @map("lease_epoch")
  createdAt       DateTime          @map("created_at") @db.Timestamptz(6)
  lastHeartbeatAt DateTime?         @map("last_heartbeat_at") @db.Timestamptz(6)
  certificates    NodeCertificate[]
  actions         AgentAction[]
  allocations     Allocation[]
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, name])
  @@unique([organizationId, id])
  @@map("nodes")
}

/// Client certificates issued to a node; revocation is a deny list of serials (SPEC 3.2).
model NodeCertificate {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  nodeId         String    @map("node_id") @db.Uuid
  serial         String    @unique @db.VarChar(64)
  notBefore      DateTime  @map("not_before") @db.Timestamptz(6)
  notAfter       DateTime  @map("not_after") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  node           Node      @relation(fields: [organizationId, nodeId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([organizationId, nodeId])
  @@map("node_certificates")
}

/// Issued confirmation token (SPEC 3.6): binding and single-use state, never the signed token.
model ConfirmationToken {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  action         String       @db.VarChar(64)
  target         String       @db.VarChar(128)
  issuedAt       DateTime     @map("issued_at") @db.Timestamptz(6)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt         DateTime?    @map("used_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([organizationId, issuedAt])
  @@map("confirmation_tokens")
}

/// Durable action queued for one node (PLAN M1.4a2); the action message is encrypted.
model AgentAction {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  nodeId         String    @map("node_id") @db.Uuid
  kind           String    @db.VarChar(64)
  idempotencyKey String    @map("idempotency_key") @db.VarChar(128)
  payloadEnc     Bytes     @map("payload_enc")
  leaseEpoch     Int       @map("lease_epoch")
  deadline       DateTime  @db.Timestamptz(6)
  state          String    @db.VarChar(16)
  step           String    @default("") @db.VarChar(64)
  attempts       Int       @default(0)
  result         Json?
  error          String?   @db.VarChar(256)
  requestedBy    String?   @map("requested_by") @db.VarChar(128)
  createdAt      DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  node           Node      @relation(fields: [organizationId, nodeId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([nodeId, idempotencyKey])
  @@index([organizationId, nodeId, state])
  @@map("agent_actions")
}

/// Environment secret (SPEC 9): the value is encrypted and never returned by the API.
model Secret {
  id             String      @id @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  projectId      String      @map("project_id") @db.Uuid
  environmentId  String      @map("environment_id") @db.Uuid
  name           String      @db.VarChar(128)
  valueEnc       Bytes       @map("value_enc")
  version        Int
  updatedBy      String?     @map("updated_by") @db.VarChar(128)
  createdAt      DateTime    @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @map("updated_at") @db.Timestamptz(6)
  environment    Environment @relation(fields: [organizationId, projectId, environmentId], references: [organizationId, projectId, id], onDelete: Cascade, onUpdate: Restrict, map: "secrets_environment_fkey")

  @@unique([environmentId, name])
  @@index([organizationId, environmentId])
  @@map("secrets")
}

model Application {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  projectId      String       @map("project_id") @db.Uuid
  environmentId  String       @map("environment_id") @db.Uuid
  name           String       @db.VarChar(40)
  source         String       @db.VarChar(16)
  config         Json
  configSha      String       @map("config_sha") @db.Char(64)
  createdBy      String?      @map("created_by") @db.VarChar(128)
  createdAt      DateTime     @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @map("updated_at") @db.Timestamptz(6)
  environment    Environment  @relation(fields: [organizationId, projectId, environmentId], references: [organizationId, projectId, id], onDelete: Cascade, onUpdate: Restrict, map: "applications_environment_fkey")
  releases       Release[]
  deployments    Deployment[]
  allocations    Allocation[]

  @@unique([environmentId, name])
  @@unique([organizationId, id])
  @@index([organizationId, environmentId])
  @@map("applications")
}

/// Immutable; only image_digest may be set once (trigger releases_write_once, column grant).
model Release {
  id             String       @id @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  applicationId  String       @map("application_id") @db.Uuid
  number         Int
  image          String       @db.VarChar(512)
  imageDigest    String?      @map("image_digest") @db.VarChar(71)
  config         Json
  configSha      String       @map("config_sha") @db.Char(64)
  createdBy      String?      @map("created_by") @db.VarChar(128)
  createdAt      DateTime     @map("created_at") @db.Timestamptz(6)
  application    Application  @relation(fields: [organizationId, applicationId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict, map: "releases_application_fkey")
  deployments    Deployment[]
  allocations    Allocation[]

  @@unique([applicationId, number])
  @@unique([organizationId, id])
  @@map("releases")
}

/// One active deployment per application: partial unique index deployments_one_active_key.
model Deployment {
  id             String      @id @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  applicationId  String      @map("application_id") @db.Uuid
  releaseId      String      @map("release_id") @db.Uuid
  state          String      @db.VarChar(16)
  planBuild      Boolean     @map("plan_build")
  planRelease    Boolean     @map("plan_release")
  trigger        String      @db.VarChar(16)
  actorId        String?     @map("actor_id") @db.VarChar(128)
  error          String?     @db.VarChar(512)
  startedAt      DateTime    @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?   @map("finished_at") @db.Timestamptz(6)
  updatedAt      DateTime    @map("updated_at") @db.Timestamptz(6)
  application    Application @relation(fields: [organizationId, applicationId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict, map: "deployments_application_fkey")
  release        Release     @relation(fields: [organizationId, releaseId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict, map: "deployments_release_fkey")

  @@index([applicationId, startedAt(sort: Desc)])
  @@index([releaseId])
  @@map("deployments")
}

/// One replica of a release on a node (SPEC 4), placed before the pipeline starts it.
model Allocation {
  id             String                 @id @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  applicationId  String                 @map("application_id") @db.Uuid
  releaseId      String                 @map("release_id") @db.Uuid
  nodeId         String                 @map("node_id") @db.Uuid
  replica        Int
  container      String                 @db.VarChar(63)
  port           Int
  cpuMillis      Int                    @map("cpu_millis")
  memoryBytes    BigInt                 @map("memory_bytes")
  state          String                 @db.VarChar(16)
  createdAt      DateTime               @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @map("updated_at") @db.Timestamptz(6)
  application    Application            @relation(fields: [organizationId, applicationId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict, map: "allocations_application_fkey")
  release        Release                @relation(fields: [organizationId, releaseId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict, map: "allocations_release_fkey")
  node           Node                   @relation(fields: [organizationId, nodeId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "allocations_node_fkey")
  observation    AllocationObservation?

  @@unique([organizationId, id])
  @@unique([releaseId, replica])
  @@unique([nodeId, container])
  @@index([applicationId, state])
  @@index([organizationId, nodeId, state])
  @@map("allocations")
}

/// What the agent last observed for an allocation; never changes the scheduler's reservation.
model AllocationObservation {
  allocationId   String     @id @map("allocation_id") @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  containerId    String?    @map("container_id") @db.Char(64)
  state          String     @db.VarChar(16)
  observedAt     DateTime   @map("observed_at") @db.Timestamptz(6)
  allocation     Allocation @relation(fields: [organizationId, allocationId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict, map: "allocation_observations_allocation_fkey")

  @@unique([organizationId, allocationId])
  @@map("allocation_observations")
}
