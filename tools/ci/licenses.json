{
  "$comment": "Licenses the production dependencies may carry (CLAUDE.md), and the exceptions of ADR 0014. tools/ci/check-licenses.mjs applies it to Trivy's license report. Every exception names its package and license, and is approved in ADR 0014. targets are the inventories the report must hold; undetected lists package versions whose license was read by hand.",
  "allowed": ["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC", "MPL-2.0"],
  "targets": ["pnpm-lock.yaml", "agent/go.mod", "cli/go.mod", "lib/go.mod"],
