{
  "name": "@shipkeep/source",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "lint": "nx run-many -t lint typecheck",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "gen": "pnpm gen:proto && pnpm gen:config && pnpm gen:prisma && pnpm gen:openapi && pnpm gen:api-client",
    "dev": "pnpm dev:infra && pnpm dev:kek && pnpm prisma migrate deploy && pnpm dev:database-role && nx run-many -t serve -p api web --parallel=2",
    "test:integration": "nx run-many -t test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install && pnpm gen:prisma",
    "proto:lint": "buf lint && buf format -d --exit-code",
    "proto:breaking": "buf breaking --against '.git#branch=main'",
    "gen:proto": "buf generate",
    "gen:config": "node tools/gen/config-schema.mjs && tools/gen/config-go.sh",
    "dev:infra": "docker compose --project-directory . -f deploy/dev/compose.yml up -d --wait",
    "dev:infra:down": "docker compose --project-directory . -f deploy/dev/compose.yml down",
    "dev:infra:reset": "docker compose --project-directory . -f deploy/dev/compose.yml down -v",
    "semgrep:test": "semgrep --test --config .semgrep/rules .semgrep/tests --metrics=off",
    "semgrep:scan": "semgrep scan --config .semgrep/rules --exclude .semgrep/tests --metrics=off --error",
    "gen:prisma": "prisma generate --config apps/api/prisma.config.ts",
    "gen:openapi": "nx build api && node tools/gen/openapi.mjs",
    "gen:api-client": "openapi-typescript apps/api/openapi.json -o packages/api-client/src/gen/openapi.ts --export-type --immutable --alphabetize",
    "prisma": "prisma --config apps/api/prisma.config.ts",
    "dev:kek": "node tools/dev/ensure-kek.mjs",
    "dev:database-role": "node tools/dev/database-role.mjs",
    "test:browser": "nx run api:test:browser"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/router": "~22.2.0",
    "@nestjs/common": "^12.3.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.1",
    "@nestjs/platform-express": "^12.3.1",
    "@nestjs/swagger": "^12.0.5",
    "@peculiar/x509": "^2.2.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@shipkeep/api-client": "workspace:*",
    "@shipkeep/config-schema": "workspace:*",
    "argon2": "0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "emailjs": "5.0.4",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.3.1",
    "otpauth": "9.4.1",
    "pg": "^8.23.1",
    "pg-boss": "12.38.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "uuid": "^14.0.3",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.2.0",
    "@angular-devkit/schematics": "~22.2.0",
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@angular/language-service": "~22.2.0",
    "@axe-core/playwright": "4.14.0",
    "@bufbuild/buf": "1.75.0",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^12.0.11",
    "@nestjs/testing": "^12.3.1",
    "@nx/angular": "24.0.0",
    "@nx/eslint": "24.0.0",
    "@nx/eslint-plugin": "24.0.0",
    "@nx/js": "24.0.0",
    "@nx/node": "24.0.0",
    "@nx/vite": "24.0.0",
    "@nx/vitest": "24.0.0",
    "@nx/web": "24.0.0",
    "@nx/webpack": "24.0.0",
    "@schematics/angular": "~22.2.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/utils": "^8.58.0",
    "@vitest/coverage-v8": "^4.1.12",
    "angular-eslint": "^22.5.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^27.1.0",
    "json-schema-to-typescript": "16.0.0",
    "jsonc-eslint-parser": "^2.1.0",
    "lefthook": "^2.2.2",
    "nx": "24.0.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "1.64.1",
    "postcss": "8.5.32",
    "prettier": "^3.8.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tailwindcss": "4.3.3",
    "testcontainers": "^12.2.1",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.12",
    "webpack": "~5.110.0",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "packageManager": "pnpm@11.28.6",
  "description": "Shipkeep: self-hosted PaaS, your own cloud on your own servers",
  "engines": {
    "node": ">=22 <23"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "lint": {
        "command": "eslint eslint.config.mjs tools",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/eslint.config.mjs",
          "{workspaceRoot}/tools/**/*"
        ]
      }
    }
  }
}
