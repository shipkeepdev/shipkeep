{
  "name": "@shipkeep/source",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "lint": "nx run-many -t lint typecheck",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "gen": "pnpm gen:proto && pnpm gen:config",
    "dev": "pnpm dev:infra && nx run-many -t serve -p api web --parallel=2",
    "test:integration": "echo \"pnpm test:integration: no integration tests yet (M1.2)\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install",
    "proto:lint": "buf lint && buf format -d --exit-code",
    "proto:breaking": "buf breaking --against '.git#branch=main'",
    "gen:proto": "buf generate",
    "gen:config": "node tools/gen/config-schema.mjs && tools/gen/config-go.sh",
    "dev:infra": "docker compose --project-directory . -f deploy/dev/compose.yml up -d --wait",
    "dev:infra:down": "docker compose --project-directory . -f deploy/dev/compose.yml down",
    "dev:infra:reset": "docker compose --project-directory . -f deploy/dev/compose.yml down -v",
    "semgrep:test": "semgrep --test --config .semgrep/rules .semgrep/tests --metrics=off",
    "semgrep:scan": "semgrep scan --config .semgrep/rules --exclude .semgrep/tests --metrics=off --error"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/router": "~22.2.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.2.0",
    "@angular-devkit/schematics": "~22.2.0",
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@angular/language-service": "~22.2.0",
    "@bufbuild/buf": "1.75.0",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/angular": "24.0.0",
    "@nx/eslint": "24.0.0",
    "@nx/eslint-plugin": "24.0.0",
    "@nx/jest": "24.0.0",
    "@nx/js": "24.0.0",
    "@nx/nest": "24.0.0",
    "@nx/node": "24.0.0",
    "@nx/vite": "24.0.0",
    "@nx/vitest": "24.0.0",
    "@nx/web": "24.0.0",
    "@nx/webpack": "24.0.0",
    "@schematics/angular": "~22.2.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@swc/jest": "~0.2.38",
    "@types/jest": "~30.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/utils": "^8.58.0",
    "@vitest/coverage-v8": "^4.1.12",
    "angular-eslint": "^22.5.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jsdom": "^27.1.0",
    "json-schema-to-typescript": "16.0.0",
    "jsonc-eslint-parser": "^2.1.0",
    "lefthook": "^2.2.2",
    "nx": "24.0.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.12",
    "webpack": "~5.110.0",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "packageManager": "pnpm@11.28.6",
  "description": "Shipkeep: self-hosted PaaS, your own cloud on your own servers",
  "engines": {
    "node": ">=22 <23"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "lint": {
        "command": "eslint eslint.config.mjs jest.preset.js",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/eslint.config.mjs",
          "{workspaceRoot}/jest.preset.js"
        ]
      }
    }
  }
}
