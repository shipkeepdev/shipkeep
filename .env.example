# Copy to .env for local development. Every value here is fake; never commit a real .env.
# The control plane reads these at startup (task M2.1 adds validation).

NODE_ENV=development
API_PORT=3000
TRUST_PROXY=none
# Browser origin: Angular proxies /api to port 3000 during `pnpm dev`.
API_PUBLIC_URL=http://localhost:4200
# In production, the API serves dist/apps/web/browser by default. Override for packaged layouts.
# WEB_DIST_DIR=/opt/shipkeep/web/browser
LOG_LEVEL=debug
# Interactive API docs at /api/v1/docs (on by default outside production).
OPENAPI_UI=true

# PostgreSQL started by deploy/dev/compose.yml (task M0.5).
DATABASE_URL=postgresql://shipkeep:shipkeep@localhost:5432/shipkeep

# Host ports of the dev stack. Change one when it is already taken on your machine, and keep the
# matching URL above in sync.
SHIPKEEP_DEV_POSTGRES_PORT=5432
SHIPKEEP_DEV_VICTORIALOGS_PORT=9428
SHIPKEEP_DEV_VICTORIAMETRICS_PORT=8428
SHIPKEEP_DEV_REGISTRY_PORT=5000

# Key-encryption key file for envelope encryption (SPEC section 9): 32 raw bytes or base64, mode 0400.
# `pnpm dev` generates this development one; the installer generates the real one.
SHIPKEEP_KEK_FILE=./deploy/dev/secrets/kek

# Agent gateway (gRPC over mTLS) listen address.
AGENT_GATEWAY_ADDR=0.0.0.0:7443

# Observability stack from deploy/dev/compose.yml.
VICTORIALOGS_URL=http://localhost:9428
VICTORIAMETRICS_URL=http://localhost:8428

# Local OCI registry.
REGISTRY_URL=http://localhost:5000

# Identity emails: implicit TLS with certificate and hostname verification (typically port 465).
# Set HOST and FROM together. Authentication is optional; USER and PASSWORD must be paired.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_FROM=notifications@example.com
# SMTP_USER=example-user
# SMTP_PASSWORD=example-password-only
# Optional public CA bundle for a private SMTP server; no TLS verification bypass exists.
# SMTP_CA_FILE=/etc/shipkeep/smtp-ca-bundle.crt
