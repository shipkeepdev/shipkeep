# Copy to .env for local development. Every value here is fake; never commit a real .env.
# The control plane reads these at startup (task M2.1 adds validation).

NODE_ENV=development
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000

# PostgreSQL started by deploy/dev/compose.yml (task M0.5).
DATABASE_URL=postgresql://shipkeep:shipkeep@localhost:5432/shipkeep

# Key-encryption key file for envelope encryption (SPEC section 9). Dev only; the installer generates the real one.
SHIPKEEP_KEK_FILE=./deploy/dev/secrets/kek

# Agent gateway (gRPC over mTLS) listen address.
AGENT_GATEWAY_ADDR=0.0.0.0:7443

# Observability stack from deploy/dev/compose.yml.
VICTORIALOGS_URL=http://localhost:9428
VICTORIAMETRICS_URL=http://localhost:8428

# Local OCI registry.
REGISTRY_URL=http://localhost:5000
